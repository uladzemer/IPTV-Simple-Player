<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия и перенос на новую приставку для Android 12+: то же, что в backup_rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/tv_settings.preferences_pb" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/tv_settings.preferences_pb" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
